NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
TMDB_API_KEY=your-tmdb-api-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret sent as `Authorization: Bearer <ADMIN_SECRET>` to the admin endpoints
# (e.g. POST /api/admin/backfill-collections).
ADMIN_SECRET=your-admin-secret
# Gate on /signup. Checked server-side only, so it is NOT NEXT_PUBLIC_ — the
# browser never sees it and the form cannot validate it before submitting.
# Leave this unset and signup is disabled entirely (the route returns 503),
# which is the right setting for a single-user instance. Make it long and
# random: the throttle in the route is per-instance and only a speed bump.
SIGNUP_INVITE_CODE=
# Optional. Base URL of a self-hosted IPTV search page. When unset, the
# "Watch on IPTV" button in the media modal is hidden.
NEXT_PUBLIC_IPTV_URL=http://localhost:3003
